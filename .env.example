# Create a key at https://app.vulnify.io (Settings > API keys). Never commit your real .env.
VULNIFY_API_KEY=vln_live_replace_me
# Optional. Defaults to https://api.vulnify.io
# VULNIFY_BASE_URL=https://api.vulnify.io
# Seconds to wait for a human to approve a REVIEW (in Vulnify or Slack)
VULNIFY_REVIEW_TIMEOUT=300
