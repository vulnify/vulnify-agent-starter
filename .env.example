# Sign up at https://app.vulnify.io and create a TEST key (API keys).
# Paste it below. The real file is .env, which is gitignored. Do not commit a key.
VULNIFY_API_KEY=vln_test_replace_me

# Optional. Defaults to https://api.vulnify.io
# VULNIFY_BASE_URL=https://api.vulnify.io

# Seconds to wait when a call is REVIEW. 0 prints the decision and moves on.
# Set this above 0 to wait for a person to approve in Vulnify or in Slack.
VULNIFY_REVIEW_TIMEOUT=0

# Optional agent name. A new name registers on first use.
# VULNIFY_AGENT=StarterAgent

# Set to 1 to evaluate vulnify/policies on this machine. No key and no network.
# VULNIFY_MOCK=1
